# Copy this file to .env and fill in the values from LiveKit Cloud.
# Rotate any API secret that was shared in a screenshot or chat.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_rotated_livekit_api_secret
LIVEKIT_ROOM_NAME=drama-team-family

# Push reminder backend. Keep these server-side; never add them to browser JS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VAPID_PUBLIC_KEY=generate_with_npm_run_vapid_generate
VAPID_PRIVATE_KEY=generate_with_npm_run_vapid_generate
VAPID_SUBJECT=mailto:you@example.com

# Umukomite moderation login. Generate secure local values with npm run vapid:generate.
UMUKOMITE_PASSWORD=generate_with_npm_run_vapid_generate
MANAGER_SESSION_SECRET=generate_with_npm_run_vapid_generate
