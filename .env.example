# Copy this file to .env and fill in the values from LiveKit Cloud.
# Rotate any API secret that was shared in a screenshot or chat.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_rotated_livekit_api_secret
LIVEKIT_ROOM_NAME=drama-team-family

# Netlify server-side Supabase access, including manager gallery deletion.
# Keep these server-side; never add them to browser JS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Manager login and signed sessions. Use independently generated random values.
UMUKOMITE_PASSWORD=replace-with-a-private-passphrase-at-least-12-characters
MANAGER_SESSION_SECRET=replace-with-32-or-more-random-characters
DEVICE_TOKEN_SECRET=replace-with-a-different-32-or-more-random-characters
# Developer console is local only. Never configure DEV_MASTER_KEY in Netlify.
DEV_MASTER_KEY=replace-with-a-local-only-random-secret
VAPID_PUBLIC_KEY=replace-with-your-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-generated-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Set these as Supabase Edge Function secrets for get-upload-url and as Netlify
# function environment variables for manager photo/video deletion. The B2 key
# needs readFiles, writeFiles, listFiles, and deleteFiles, scoped to the gallery
# bucket and videos/ prefix when possible.
# If the B2 key is not bucket-scoped, it also needs listBuckets to resolve the bucket ID.
# Use the S3 endpoint and region shown beside your B2 bucket.
B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
B2_REGION=<your-region>
B2_BUCKET_NAME=your_private_bucket_name
B2_KEY_ID=your_bucket_scoped_key_id
B2_APP_KEY=your_bucket_scoped_application_key

# Optional one-time CORS key; needs listBuckets and writeBuckets.
# Set it only in your local .env/PowerShell session, then revoke it after use.
# B2_CORS_KEY_ID=temporary_bucket_admin_key_id
# B2_CORS_APP_KEY=temporary_bucket_admin_application_key
